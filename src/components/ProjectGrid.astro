---
// Filterable grid of every page marked `project: true`, by category and status.
import { getCollection } from 'astro:content';
import { CATEGORIES, STATUSES } from '../content.config';
import StatusBadge from './StatusBadge.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('docs', (e) => e.data.project === true)).sort((a, b) =>
	(b.data.updated ?? '').localeCompare(a.data.updated ?? '')
);
---

<div class="ss-grid-filters not-content">
	<label>
		Category
		<select data-filter="category">
			<option value="">All</option>
			{CATEGORIES.map((c) => <option>{c}</option>)}
		</select>
	</label>
	<label>
		Status
		<select data-filter="status">
			<option value="">All</option>
			{STATUSES.map((s) => <option>{s}</option>)}
		</select>
	</label>
</div>

<ul class="ss-grid not-content">
	{projects.map((p) => (
		<li class="ss-surface ss-grid__card" data-category={p.data.category} data-status={p.data.status}>
			<a href={`${base}/${p.id}/`} class="ss-grid__title">{p.data.title}</a>
			<p class="ss-grid__summary">{p.data.summary ?? p.data.description}</p>
			<p class="ss-grid__meta">
				{p.data.status && <StatusBadge status={p.data.status} />}
				<span>{p.data.category}</span>
			</p>
		</li>
	))}
</ul>
<p class="ss-grid-empty" hidden>No projects match these filters yet.</p>

<script>
	const selects = document.querySelectorAll<HTMLSelectElement>('[data-filter]');
	const cards = document.querySelectorAll<HTMLElement>('.ss-grid__card');
	const empty = document.querySelector<HTMLElement>('.ss-grid-empty');
	const apply = () => {
		let shown = 0;
		cards.forEach((card) => {
			const ok = [...selects].every((s) => !s.value || card.dataset[s.dataset.filter!] === s.value);
			card.hidden = !ok;
			if (ok) shown++;
		});
		if (empty) empty.hidden = shown > 0;
	};
	selects.forEach((s) => s.addEventListener('change', apply));
</script>

<style>
	.ss-grid-filters { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 1rem; }
	.ss-grid-filters label { display: flex; flex-direction: column; gap: 0.25rem; font-size: var(--sl-text-xs); color: var(--ss-muted); }
	.ss-grid-filters select { font: inherit; font-size: var(--sl-text-sm); padding: 0.35rem 0.5rem; background: var(--ss-surface); color: var(--ss-text); border: 1px solid var(--ss-border); border-radius: 0.25rem; }
	.ss-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1rem; }
	.ss-grid__card[hidden] { display: none; }
	.ss-grid__title { font-family: var(--ss-font-heading); font-weight: 600; font-size: var(--sl-text-lg); color: var(--ss-text); text-decoration: none; }
	.ss-grid__title:hover { color: var(--ss-accent); }
	.ss-grid__summary { margin: 0.4rem 0 0.75rem; color: var(--ss-muted); font-size: var(--sl-text-sm); }
	.ss-grid__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0; font-size: var(--sl-text-xs); color: var(--ss-muted); }
</style>
