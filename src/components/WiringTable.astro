---
// Wire-by-wire plan. Every row should come from the install config sheet or a manufacturer manual.
interface Wire {
	wire: string;
	color: string;
	function: string;
	source: string;
	draw?: string;
	fuse?: string;
	gauge?: string;
	relay?: string;
	termination?: string;
	ground?: string;
}

interface Props {
	rows: Wire[];
}

const { rows } = Astro.props;
const tbd = 'TBD';
---

<div class="ss-table-wrap not-content">
	<table class="ss-table">
		<thead>
			<tr>
				<th>Wire</th><th>Color</th><th>Function</th><th>Source output</th><th>Draw</th>
				<th>Fuse</th><th>Gauge</th><th>Relay pin</th><th>Termination</th><th>Ground</th>
			</tr>
		</thead>
		<tbody>
			{rows.map((r) => (
				<tr>
					<td class="ss-mono">{r.wire}</td>
					<td class="ss-mono">{r.color}</td>
					<td>{r.function}</td>
					<td class="ss-mono">{r.source}</td>
					<td class="ss-mono">{r.draw ?? tbd}</td>
					<td class="ss-mono">{r.fuse ?? tbd}</td>
					<td class="ss-mono">{r.gauge ?? tbd}</td>
					<td class="ss-mono">{r.relay ?? '—'}</td>
					<td>{r.termination ?? tbd}</td>
					<td>{r.ground ?? tbd}</td>
				</tr>
			))}
		</tbody>
	</table>
</div>

<style>
	.ss-table { border-collapse: collapse; margin-block: 1rem; }
	.ss-table :is(th, td) { border: 1px solid var(--ss-border); padding: 0.45rem 0.6rem; text-align: left; vertical-align: top; }
	.ss-table th { background: var(--ss-surface); color: var(--ss-muted); font-weight: 600; font-size: var(--sl-text-xs); text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; }
	.ss-table td { color: var(--ss-text); }
</style>
