---
// Captioned photo grid. Strip EXIF/GPS and blur plates and house numbers before adding any photo.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	photos: Photo[];
}

const { photos } = Astro.props;
---

<div class="ss-gallery not-content">
	{photos.map((p) => (
		<figure>
			<Image src={p.src} alt={p.alt} widths={[400, 800]} sizes="(min-width: 50rem) 22rem, 100vw" />
			{p.caption && <figcaption>{p.caption}</figcaption>}
		</figure>
	))}
</div>

<style>
	.ss-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; margin-block: 1rem; }
	.ss-gallery figure { margin: 0; }
	.ss-gallery img { width: 100%; height: auto; border-radius: 0.375rem; border: 1px solid var(--ss-border); }
	.ss-gallery figcaption { margin-top: 0.35rem; font-size: var(--sl-text-xs); color: var(--ss-muted); }
</style>
