---
// Captioned photo grid. Strip EXIF/GPS and blur plates and house numbers before adding any photo.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	photos: Photo[];
	// One full-width column, for charts and diagrams that must stay readable.
	wide?: boolean;
}

const { photos, wide = false } = Astro.props;
---

<div class:list={['ss-gallery', 'not-content', { wide }]}>
	{photos.map((p) => (
		<figure>
			<Image src={p.src} alt={p.alt} widths={wide ? [800, 1600] : [400, 800]} sizes={wide ? '(min-width: 50rem) 45rem, 100vw' : '(min-width: 50rem) 22rem, 100vw'} />
			{p.caption && <figcaption>{p.caption}</figcaption>}
		</figure>
	))}
</div>

<style>
	.ss-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; margin-block: 1rem; }
	.ss-gallery.wide { grid-template-columns: 1fr; }
	.ss-gallery figure { margin: 0; }
	.ss-gallery img { width: 100%; height: auto; border-radius: 0.375rem; border: 1px solid var(--ss-border); }
	.ss-gallery figcaption { margin-top: 0.35rem; font-size: var(--sl-text-xs); color: var(--ss-muted); }
</style>
